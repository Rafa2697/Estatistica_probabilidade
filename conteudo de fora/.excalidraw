    {
      "id": "xLY0KkTuSwspJCUeJr-m-",
      "type": "text",
      "x": 1299.372688991024,
      "y": 1045.9960505466443,
      "width": 224.14381408691406,
      "height": 220,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "c105fmGmlKTGnoAYGgiHT",
      "index": "avzx",
      "roundness": null,
      "seed": 789962233,
      "version": 174,
      "versionNonce": 2124961529,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793307339512,
      "link": null,
      "locked": false,
      "text": "n(S) = 36 -> 6 . 6 = 36\n\nn(A) = 6\nP(A) = 6/36 = 1/6\n\nn(B) = 18\nP(B) = 18/36 = 1/2 = 0,5\n\nn(C) = 10\nP(C) = 10/36 = 5/18 = 0,277\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "n(S) = 36 -> 6 . 6 = 36\n\nn(A) = 6\nP(A) = 6/36 = 1/6\n\nn(B) = 18\nP(B) = 18/36 = 1/2 = 0,5\n\nn(C) = 10\nP(C) = 10/36 = 5/18 = 0,277\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
